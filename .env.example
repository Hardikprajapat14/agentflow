# ---------- LLM (free) ----------
# Get a free key (no credit card) at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Used automatically if the primary model is rate-limited (higher free limits)
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# Other free options (any OpenAI-compatible API works):
#   OpenRouter free models : LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Google Gemini          : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
#   Fully local (Ollama)   : LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=llama3.1   (no key needed)

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Infrastructure (docker-compose overrides these hosts automatically) ----------
DATABASE_URL=postgresql+psycopg2://agentflow:agentflow@localhost:5432/agentflow
REDIS_URL=redis://localhost:6379/0
# Dev-only: run workflows in a thread instead of Celery (no Redis needed)
CELERY_EAGER=false

# ---------- Embeddings (free, local, no key) ----------
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---------- Optional: email tool (approval-gated). Any SMTP works, e.g. a free Gmail app password ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
